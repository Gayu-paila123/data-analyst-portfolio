        "SELECT\n",
        "    Category,\n",
        "    SUM(Quantity * Price) AS Revenue,\n",
        "    ROUND(\n",
        "        SUM(Quantity * Price) * 100.0 /\n",
        "        (SELECT SUM(Quantity * Price) FROM customers),\n",
        "        2\n",
        "    ) AS Revenue_Percentage\n",
        "FROM customers\n",
        "GROUP BY Category\n",
        "ORDER BY Revenue DESC;\n",
        "\"\"\"\n",
